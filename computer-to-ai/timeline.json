      {
       "text": "几条简单的规则",
       "start": 22.159,
       "end": 23.632
      }
     ]
    },
    {
     "text": "他证明，只要规则写对，这台机器能完成一切可以计算的事。",
     "start": 23.992,
     "end": 28.957,
     "subs": [
      {
       "text": "他证明，只要规则写对",
       "start": 23.992,
       "end": 26.015
      },
      {
       "text": "这台机器能完成一切可以计算的事",
       "start": 26.015,
       "end": 28.957
      }
     ]
    },
    {
     "text": "十四年后，他又问了一个更大胆的问题：",
     "start": 29.317,
     "end": 32.579,
     "subs": [
      {
       "text": "十四年后",
       "start": 29.317,
       "end": 30.223
      },
      {
       "text": "他又问了一个更大胆的问题",
       "start": 30.223,
       "end": 32.579
      }
     ]
    },
    {
     "text": "机器，能思考吗？",
     "start": 32.799,
     "end": 34.214,
     "subs": [
      {
       "text": "机器，能思考吗？",
       "start": 32.799,
       "end": 34.214
      }
     ]
