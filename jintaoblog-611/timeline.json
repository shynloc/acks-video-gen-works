       "end": 324.249
      },
      {
       "text": "设计永无止境",
       "start": 324.249,
       "end": 325.422
      }
     ]
    },
    {
     "text": "它用杂志式的排版，讲产品背后的人和故事，比如《Code is a Design Material》。",
     "start": 325.782,
     "end": 331.177,
     "subs": [
      {
       "text": "它用杂志式的排版",
       "start": 325.782,
       "end": 327.191
      },
      {
       "text": "讲产品背后的人和故事",
       "start": 327.191,
       "end": 328.914
      },
      {
       "text": "比如《Code is a Design Material》",
       "start": 328.914,
       "end": 331.177
      }
     ]
    },
    {
     "text": "把它加入阅读列表，定期读，比刷碎片化作品有营养得多。",
     "start": 331.537,
     "end": 336.284,
     "subs": [
      {
       "text": "把它加入阅读列表，定期读",
       "start": 331.537,
       "end": 333.911
      },
      {
       "text": "比刷碎片化作品有营养得多",
       "start": 333.911,
       "end": 336.284
      }
     ]
    }
   ],
   "end": 336.834
