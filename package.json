  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
